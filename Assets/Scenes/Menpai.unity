  m_Text: "\u5E08\u7236\uFF1A<color='red'>\u5F20\u4E09\u4E30\u3001\u6B66\u5F53\u4E03\u4FA0</color>\r\n\u9876\u7EA7\u6B66\u5B66\uFF1A<color='yellow'>\u7EAF\u9633\u65E0\u6781\u529F\u3001\u592A\u6781\u62F3/\u5251</color>\r\n\u4E3B\u4FEE\uFF1A<color='magenta'>\u62F3/\u5251\u3001\u5185\u529F</color>\r\n\u95E8\u6D3E\u7279\u70B9\uFF1A<color='cyan'>\u9AD8\u5965\u4E49\u63A7\u573A</color>\r\n"
