  m_text: "\u7531\u6C49\u5BB6\u677E\u9F20\u5DE5\u4F5C\u5BA4\u5F00\u53D1\u7684\u4E00\u6B3E\u5355\u673A\u6B66\u4FA0\u89D2\u8272\u626E\u6F14\u6E38\u620F\uFF0C\u6700\u521D\u4E8E2013\u5E74\u4EE5\u7F51\u9875\u6E38\u620F\u5F62\u5F0F\u53D1\u5E03\u3002\u6E38\u620F\u4EE5\u91D1\u5EB8\u5341\u4E94\u90E8\u5C0F\u8BF4\u4E3A\u80CC\u666F\uFF0C\u878D\u5408\u539F\u8457\u89D2\u8272\u4E0E\u539F\u521B\u5267\u60C5\uFF0C\u6784\u5EFA\u9AD8\u81EA\u7531\u5EA6\u6B66\u4FA0\u4E16\u754C\u3002\u6E38\u620F\u91C7\u7528\u65F6\u95F4\u9A71\u52A8\u673A\u5236\u63A8\u8FDB\u4E3B\u7EBF\u5267\u60C5\uFF0C\u63D0\u4F9B\u591A\u5468\u76EE\u7CFB\u7EDF\u53CA\u7B80\u5355\u3001\u8FDB\u9636\u3001\u70BC\u72F1\u3001\u65E0\u6094\u56DB\u79CD\u96BE\u5EA6\u5206\u7EA7\uFF0C\u6218\u6597\u6A21\u5F0F\u4E3A\u56DE\u5408\u5236\u6218\u68CB\u73A9\u6CD5\u3002\u73A9\u5BB6\u53EF\u901A\u8FC7\u89D2\u8272\u521B\u5EFA\u7CFB\u7EDF\u81EA\u5B9A\u4E49\u51FA\u8EAB\u80CC\u666F\u4E0E\u5C5E\u6027\u503E\u5411\uFF0C\u6536\u96C6\u4E0A\u767E\u79CD\u6B66\u529F\u79D8\u7C4D\u5E76\u57F9\u517B\u961F\u53CB\u53C2\u4E0E\u6C5F\u6E56\u4E8B\u4EF6\u3002\u6E38\u620F\u4E0D\u65AD\u8FED\u4EE3\u66F4\u65B0\uFF0C\u901A\u8FC7\u7248\u672C\u4F18\u5316\u63D0\u5347\u7A33\u5B9A\u6027\uFF0C1.1.0.6\u7248\u672C\u4FEE\u590D\u4E86\u5916\u529F\u653B\u51FB\u8DDD\u79BB\u3001\u7BB1\u5B50\u5BB9\u91CF\u9650\u5236\u7B49\u5173\u952EBUG\uFF0C\u5E76\u652F\u6301\u73A9\u5BB6\u81EA\u5236MOD\u6269\u5C55\u5185\u5BB9\uFF0C\u5B98\u65B9\u5F00\u653E\u4E86MOD\u7F16\u8F91\u5668\uFF0C\u5F62\u6210\u4E86\u6D3B\u8DC3\u7684MOD\u521B\u4F5C\u793E\u533A
